{
  "name": "api",
  "version": "1.6.9",
  "type": "module",
  "private": true,
  "description": "Express API for i-wash-noda",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "deva": "pnpm prisma dev & tsx watch ./src/server.ts",
    "dev": "tsx watch ./src/server.ts",
    "build": "tsup --clean && prisma generate",
    "start": "node dist/server.js",
    "prisma:generate": "pnpm prisma generate",
    "prisma:migrate": "pnpm prisma migrate deploy",
    "prisma:deploy": "pnpm prisma:generate && pnpm prisma:migrate",
    "prisma:seed": "tsx ./prisma/seed.ts",
    "prisma:seed:worker-station": "tsx ./prisma/seedWorkerStation.ts",
    "prisma:seed:fake-data": "tsx ./prisma/seedFakeData.ts",
    "prisma:dev": "pnpm prisma migrate dev && pnpm prisma generate"
  },
  "keywords": [
    "expres.js",
    "prisma orm"
  ],
  "author": "Wahyu Pratama (@ayuatama)",
  "license": "ISC",
  "dependencies": {
